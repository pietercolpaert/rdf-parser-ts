{
  "name": "rdf-parser-ts",
  "type": "commonjs",
  "version": "0.4.0",
  "description": "Fast RDF-JS parser for Turtle, TriG, N-Triples, N-Quads, and RDF Messages for NodeJS and browsers.",
  "author": "Pieter Colpaert",
  "license": "MIT",
  "homepage": "https://github.com/pietercolpaert/rdf-parser-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pietercolpaert/rdf-parser-ts.git"
  },
  "bugs": {
    "url": "https://github.com/pietercolpaert/rdf-parser-ts/issues"
  },
  "keywords": [
    "rdf",
    "rdf-js",
    "turtle",
    "trig",
    "n-triples",
    "n-quads",
    "parser"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "default": "./dist/browser/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser/index.mjs",
  "bin": {
    "rdf-parser-ts": "./dist/bin/rdf-parser.js"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "README.md",
    "dist",
    "spec",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist coverage .rdf-test-suite-cache",
    "build": "npm run build:node && npm run build:browser",
    "build:node": "tsup src/index.ts src/bin/rdf-parser.ts --format cjs,esm --dts --target node24 --platform node --clean --splitting false --out-dir dist",
    "build:browser": "node scripts/build-browser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --cache",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "ci": "npm run check && npm run perf:regression",
    "hooks:install": "node scripts/install-hooks.cjs",
    "prepare": "npm run build && npm run hooks:install",
    "spec": "npm run build && npm run spec-clean && npm run spec-1-1 && npm run spec-1-2",
    "spec-1-1": "npm run spec-1-1-turtle && npm run spec-1-1-ntriples && npm run spec-1-1-nquads && npm run spec-1-1-trig",
    "spec-1-1-earl": "npm run spec-1-1-earl-turtle && npm run spec-1-1-earl-ntriples && npm run spec-1-1-earl-nquads && npm run spec-1-1-earl-trig",
    "spec-1-1-ntriples": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-n-triples/manifest.ttl -i '{ \"format\": \"n-triples\" }' -c .rdf-test-suite-cache/",
    "spec-1-1-nquads": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-n-quads/manifest.ttl -i '{ \"format\": \"n-quads\" }' -c .rdf-test-suite-cache/",
    "spec-1-1-turtle": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-turtle/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/",
    "spec-1-1-trig": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-trig/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/",
    "spec-1-1-earl-ntriples": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-n-triples/manifest.ttl -i '{ \"format\": \"n-triples\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-ntriples.ttl",
    "spec-1-1-earl-nquads": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-n-quads/manifest.ttl -i '{ \"format\": \"n-quads\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-nquads.ttl",
    "spec-1-1-earl-turtle": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-turtle/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-turtle.ttl",
    "spec-1-1-earl-trig": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf11/rdf-trig/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-trig.ttl",
    "spec-1-2": "npm run spec-1-2-turtle && npm run spec-1-2-ntriples && npm run spec-1-2-nquads && npm run spec-1-2-trig && npm run spec-1-2-turtle-eval && npm run spec-1-2-trig-eval",
    "spec-1-2-earl": "npm run spec-1-2-earl-turtle && npm run spec-1-2-earl-ntriples && npm run spec-1-2-earl-nquads && npm run spec-1-2-earl-trig",
    "spec-1-2-ntriples": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-triples/syntax/manifest.ttl -i '{ \"format\": \"n-triples\" }' -c .rdf-test-suite-cache/",
    "spec-1-2-nquads": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-quads/syntax/manifest.ttl -i '{ \"format\": \"n-quads\" }' -c .rdf-test-suite-cache/",
    "spec-1-2-turtle": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-turtle/syntax/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/",
    "spec-1-2-trig": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-trig/syntax/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/",
    "spec-1-2-earl-ntriples": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-triples/syntax/manifest.ttl -i '{ \"format\": \"n-triples\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-ntriples.ttl",
    "spec-1-2-earl-nquads": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-n-quads/syntax/manifest.ttl -i '{ \"format\": \"n-quads\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-nquads.ttl",
    "spec-1-2-earl-turtle": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-turtle/syntax/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-turtle.ttl",
    "spec-1-2-earl-trig": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-trig/syntax/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/ -o earl -p spec/earl-meta.json > spec/earl-trig.ttl",
    "spec-clean": "rm -rf .rdf-test-suite-cache/",
    "perf": "npm run build && node perf/bench.js",
    "perf:quick": "npm run build && node perf/bench.js --sizes 1000,10000",
    "perf:regression": "npm run build && node --expose-gc perf/regression.js",
    "perf:graphy": "npm run build && node perf/bench.js --no-triple-terms",
    "typecheck": "tsc --noEmit",
    "test:n3-extract": "node scripts/extract-n3-parser-tests.cjs",
    "spec-1-2-turtle-eval": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-turtle/eval/manifest.ttl -i '{ \"format\": \"turtle\" }' -c .rdf-test-suite-cache/",
    "spec-1-2-trig-eval": "rdf-test-suite spec/parser.cjs https://w3c.github.io/rdf-tests/rdf/rdf12/rdf-trig/eval/manifest.ttl -i '{ \"format\": \"trig\" }' -c .rdf-test-suite-cache/"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "rdf-data-factory": "^2.1.0",
    "readable-stream": "^4.7.0"
  },
  "devDependencies": {
    "@graphy/content.nq.read": "^4.3.7",
    "@rubensworks/eslint-config": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/readable-stream": "^4.0.24",
    "@vitest/coverage-v8": "^4.1.11",
    "arrayify-stream": "^3.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "eyeling": "^1.28.3",
    "n3": "^2.1.1",
    "rdf-isomorphic": "^2.0.1",
    "rdf-test-suite": "^2.1.4",
    "streamify-string": "^1.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
